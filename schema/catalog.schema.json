{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wujiaze16-lgtm.github.io/codex-skill-radar/catalog.schema.json",
  "title": "Codex Skill Radar catalog",
  "type": "object",
  "required": ["schema_version", "generated_at", "stats", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "stats": {
      "type": "object",
      "required": ["repositories_scanned", "skills_found"],
      "properties": {
        "repositories_scanned": {"type": "integer", "minimum": 0},
        "skills_found": {"type": "integer", "minimum": 0}
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "types", "repository", "skill_path", "install", "risk", "score"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "category": {
            "type": "object",
            "required": ["id", "label", "confidence", "signals"]
          },
          "types": {"type": "array", "items": {"enum": ["skill", "plugin", "mcp"]}},
          "repository": {"type": "object"},
          "skill_path": {"type": "string"},
          "install": {"type": "object"},
          "risk": {"type": "object"},
          "score": {"type": "object"}
        }
      }
    }
  }
}
